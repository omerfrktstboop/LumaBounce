# Godot 4+ specific ignores
.godot/
.import/
export.cfg

# Imported translations (automatically generated from CSV files)
*.translation

# Mono-specific ignores
.mono/
data_*/

# System/editor specific
.DS_Store
Thumbs.db

# --- Yayin gizlileri: ASLA repoya girmemeli ---
# Release imzalama anahtari kaybolursa uygulama BIR DAHA guncellenemez;
# repoya girerse baskasi senin adina guncelleme yayinlayabilir.
*.keystore
*.jks
*.p12
*.pem
keystores/
keystore.properties
*.keystore.cfg
local.properties

# GameAnalytics anahtarlari sadece yerel/CI ortaminda tutulur.
gameanalytics.cfg

# Firebase istemci yapilandirmasi: gizli anahtar degil ama projeye ozel;
# yerelde durur, export onu Gradle'a kopyalar (bkz. docs/ANALYTICS.md).
google-services.json

# Yerel imzalama ortam dosyalari; ornek/README disinda repoya ekleme.
.env
.env.*
*.release.env.ps1

# Export ciktilari
builds/
*.aab
*.apk

# Yerel arastirma/inceleme ciktilari; export paketine de alinmaz.
tmp/
scratchpad/

# Godot Android build sablonu: Project > Install Android Build Template ile
# yeniden kurulur. Icindeki motor AAR'lari GitHub'in 100 MB sinirini asar ve
# Gradle ciktilari ~1 GB tutar (Godot'un varsayilan .gitignore'u da dislar).
# Godotx Firebase modulleri (birkac KB'lik AAR'lar) ise sablonun parcasi
# DEGIL; export onlari ../android/firebase_*/ yolundan okur, repoda kalir.
/android/*
!/android/firebase_core/
!/android/firebase_analytics/
!/android/firebase_crashlytics/

# Yerel editor/ajan durumu ve kok dizindeki gecici loglar
.idea/
.codex-remote-attachments/
.claude/settings.local.json
/*.log
